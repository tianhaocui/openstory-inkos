+import { describe, expect, it } from "vitest";
+import { createHmac } from "node:crypto";
+import {
+  normalizeScriptChapters,
+  verifyOpenStoryBinding,
+} from "./openstory-integration";
+
+describe("normalizeScriptChapters", () => {
+  it("splits episodic scripts into stable OpenStory chapter sources", () => {
+    const chapters = normalizeScriptChapters(
+      "# Demo\n\n## 剧本正文\n\n### 第1集\nA\n\n### 第2集 尾声\nB\n",
+      "script",
+      "Demo",
+      "2026-09-21T00:00:00.000Z",
+    );
+    expect(chapters.map((chapter) => chapter.sourceKey)).toEqual([
+      "episode:1",
+      "episode:2",
+    ]);
+    expect(chapters[1]?.title).toBe("第2集 尾声");
+    expect(chapters[0]?.markdown).toContain("A");
+  });
+
+  it("keeps an interactive script together so branches are not silently linearized", () => {
+    const chapters = normalizeScriptChapters(
+      "# Branches\n\n### S1\nStart\n\n### E1\nEnding",
+      "interactive-film",
+      "Branches",
+    );
+    expect(chapters).toHaveLength(1);
+    expect(chapters[0]).toMatchObject({
+      sourceKey: "interactive:script",
+      title: "Branches",
+    });
+  });
+});
+
+describe("verifyOpenStoryBinding", () => {
+  it("accepts only bindings signed for the authenticated team", () => {
+    const secret = "s".repeat(64);
+    const payload = Buffer.from(
+      JSON.stringify({
+        version: 1,
+        projectId: "project-1",
+        teamId: "team-1",
+        mode: "script",
+        expiresAt: 2_000,
+      }),
+    ).toString("base64url");
+    const signature = createHmac("sha256", secret)
+      .update(`binding.${payload}`)
+      .digest("hex");
+    const binding = `${payload}.${signature}`;
+
+    expect(
+      verifyOpenStoryBinding(binding, "team-1", "script", secret, 1_000),
+    ).toBe(true);
+    expect(
+      verifyOpenStoryBinding(binding, "team-2", "script", secret, 1_000),
+    ).toBe(false);
+    expect(
+      verifyOpenStoryBinding(
+        binding,
+        "team-1",
+        "interactive-film",
+        secret,
+        1_000,
+      ),
+    ).toBe(false);
+    expect(
+      verifyOpenStoryBinding(binding, "team-1", "script", secret, 3_000),
+    ).toBe(false);
+  });
+});
diff --git a/packages/studio/src/api/openstory-integration.ts b/packages/studio/src/api/openstory-integration.ts
new file mode 100644
index 0000000..eb87ad4
--- /dev/null
+++ b/packages/studio/src/api/openstory-integration.ts
@@ -0,0 +1,375 @@
+import {
+  chmod,
+  mkdir,
+  readFile,
+  readdir,
+  rename,
+  rm,
+  writeFile,
+} from "node:fs/promises";
+import {
+  createHash,
+  createHmac,
+  randomUUID,
+  timingSafeEqual,
+} from "node:crypto";
+import { join } from "node:path";
+import { safeChildPath } from "@actalk/inkos-core";
+
+type SessionBindings = Record<string, string>;
+
+export interface GeneratedToolExecution {
+  readonly tool: string;
+  readonly details?: unknown;
+}
+
+interface GeneratedArtifactDetails {
+  readonly kind: "script_created" | "interactive_film_created";
+  readonly projectId: string;
+  readonly scriptPath: string;
+}
+
+interface NormalizedChapter {
+  readonly sourceKey: string;
+  readonly title: string;
+  readonly markdown: string;
+  readonly contentHash: string;
+  readonly sourceUpdatedAt: string;
+}
+
+const BINDINGS_FILE = "openstory-bindings.json";
+const OUTBOX_DIR = "openstory-outbox";
+const bindingMutations = new Map<string, Promise<unknown>>();
+const outboxFlushes = new Map<string, Promise<number>>();
+
+async function serialized<T>(
+  locks: Map<string, Promise<unknown>>,
+  key: string,
+  operation: () => Promise<T>,
+): Promise<T> {
+  const previous = locks.get(key) ?? Promise.resolve();
+  const current = previous.catch(() => undefined).then(operation);
+  locks.set(key, current);
+  try {
+    return await current;
+  } finally {
+    if (locks.get(key) === current) locks.delete(key);
+  }
+}
+
+function inkosMetaPath(root: string, file: string): string {
+  return join(root, ".inkos", file);
+}
+
+async function readBindings(root: string): Promise<SessionBindings> {
+  try {
+    return JSON.parse(
+      await readFile(inkosMetaPath(root, BINDINGS_FILE), "utf-8"),
+    ) as SessionBindings;
+  } catch {
+    return {};
+  }
+}
+
+async function writeBindings(
+  root: string,
+  bindings: SessionBindings,
+): Promise<void> {
+  const directory = join(root, ".inkos");
+  const target = join(directory, BINDINGS_FILE);
+  const temporary = `${target}.${randomUUID()}.tmp`;
+  await mkdir(directory, { recursive: true, mode: 0o700 });
+  await chmod(directory, 0o700);
+  await writeFile(temporary, JSON.stringify(bindings, null, 2), {
+    encoding: "utf-8",
+    mode: 0o600,
+  });
+  await rename(temporary, target);
+  await chmod(target, 0o600);
+}
+
+export async function bindOpenStorySession(
+  root: string,
+  sessionId: string,
+  binding: string,
+  expectedTeamId: string,
+  expectedMode: "script" | "interactive-film",
+  secret: string,
+): Promise<void> {
+  if (!verifyOpenStoryBinding(binding, expectedTeamId, expectedMode, secret)) {
+    throw new Error("Invalid OpenStory binding");
+  }
+  await serialized(bindingMutations, root, async () => {
+    const bindings = await readBindings(root);
+    bindings[sessionId] = binding;
+    await writeBindings(root, bindings);
+  });
+}
+
+export async function unbindOpenStorySession(
+  root: string,
+  sessionId: string,
+): Promise<void> {
+  await serialized(bindingMutations, root, async () => {
+    const bindings = await readBindings(root);
+    if (!(sessionId in bindings)) return;
+    delete bindings[sessionId];
+    await writeBindings(root, bindings);
+  });
+}
+
+export async function getOpenStorySessionBinding(
+  root: string,
+  sessionId: string,
+): Promise<string | null> {
+  const bindings = await readBindings(root);
+  return bindings[sessionId] ?? null;
+}
+
+function sha256(value: string): string {
+  return createHash("sha256").update(value).digest("hex");
+}
+
+export function verifyOpenStoryBinding(
+  binding: string,
+  expectedTeamId: string,
+  expectedMode: "script" | "interactive-film",
+  secret: string,
+  nowSeconds = Math.floor(Date.now() / 1000),
+): boolean {
+  if (!binding || binding.length > 2_000 || secret.length < 32) return false;
+  const [payload, providedHex, ...rest] = binding.split(".");
+  if (
+    !payload ||
+    !providedHex ||
+    rest.length > 0 ||
+    !/^[a-f0-9]{64}$/.test(providedHex)
+  ) {
+    return false;
+  }
+  const expected = createHmac("sha256", secret)
+    .update(`binding.${payload}`)
+    .digest();
+  const provided = Buffer.from(providedHex, "hex");
+  if (
+    provided.length !== expected.length ||
+    !timingSafeEqual(provided, expected)
+  ) {
+    return false;
+  }
+  try {
+    const value = JSON.parse(
+      Buffer.from(payload, "base64url").toString("utf-8"),
+    ) as Record<string, unknown>;
+    return (
+      value.version === 1 &&
+      value.teamId === expectedTeamId &&
+      value.mode === expectedMode &&
+      typeof value.projectId === "string" &&
+      typeof value.expiresAt === "number" &&
+      value.expiresAt >= nowSeconds
+    );
+  } catch {
+    return false;
+  }
+}
+
+function markdownTitle(markdown: string, fallback: string): string {
+  const match = markdown.match(/^#\s+(.+)$/m);
+  return match?.[1]?.trim() || fallback;
+}
+
+export function normalizeScriptChapters(
+  markdown: string,
+  artifactKind: "script" | "interactive-film",
+  fallbackTitle: string,
+  sourceUpdatedAt = new Date().toISOString(),
+): NormalizedChapter[] {
+  if (artifactKind === "interactive-film") {
+    return [
+      {
+        sourceKey: "interactive:script",
+        title: markdownTitle(markdown, `${fallbackTitle} - 互动剧本`),
+        markdown,
+        contentHash: sha256(markdown),
+        sourceUpdatedAt,
+      },
+    ];
+  }
+
+  const episodePattern = /^###\s+(第\s*\d+\s*集[^\n]*)$/gm;
+  const matches = [...markdown.matchAll(episodePattern)];
+  if (matches.length === 0) {
+    return [
+      {
+        sourceKey: "script:main",
+        title: markdownTitle(markdown, fallbackTitle),
+        markdown,
+        contentHash: sha256(markdown),
+        sourceUpdatedAt,
+      },
+    ];
+  }
+
+  return matches.map((match, index) => {
+    const start = match.index ?? 0;
+    const end = matches[index + 1]?.index ?? markdown.length;
+    const content = markdown.slice(start, end).trim();
+    const episodeNumber = match[1]?.match(/\d+/)?.[0] ?? String(index + 1);
+    return {
+      sourceKey: `episode:${episodeNumber}`,
+      title: match[1]?.trim() || `第${episodeNumber}集`,
+      markdown: content,
+      contentHash: sha256(content),
+      sourceUpdatedAt,
+    };
+  });
+}
+
+function generatedDetails(
+  exec: GeneratedToolExecution,
+): GeneratedArtifactDetails | null {
+  if (!exec.details || typeof exec.details !== "object") return null;
+  const details = exec.details as Record<string, unknown>;
+  if (
+    details.kind !== "script_created" &&
+    details.kind !== "interactive_film_created"
+  )
+    return null;
+  if (
+    typeof details.projectId !== "string" ||
+    typeof details.scriptPath !== "string"
+  )
+    return null;
+  return details as unknown as GeneratedArtifactDetails;
+}
+
+function signature(secret: string, timestamp: string, body: string): string {
+  return `v1=${createHmac("sha256", secret).update(`${timestamp}.${body}`).digest("hex")}`;
+}
+
+async function deliver(
+  endpoint: string,
+  secret: string,
+  body: string,
+): Promise<void> {
+  const timestamp = String(Math.floor(Date.now() / 1000));
+  const response = await fetch(endpoint, {
+    method: "POST",
+    headers: {
+      "content-type": "application/json",
+      "x-inkos-timestamp": timestamp,
+      "x-inkos-signature": signature(secret, timestamp, body),
+    },
+    body,
+    signal: AbortSignal.timeout(20_000),
+  });
+  if (!response.ok) {
+    throw new Error(`OpenStory sync failed with HTTP ${response.status}`);
+  }
+}
+
+async function enqueueAndDeliver(
+  root: string,
+  endpoint: string,
+  secret: string,
+  eventId: string,
+  body: string,
+): Promise<void> {
+  const directory = inkosMetaPath(root, OUTBOX_DIR);
+  const file = join(directory, `${eventId}.json`);
+  await mkdir(directory, { recursive: true, mode: 0o700 });
+  await chmod(directory, 0o700);
+  await writeFile(file, body, { encoding: "utf-8", mode: 0o600 });
+  await chmod(file, 0o600);
+  await deliver(endpoint, secret, body);
+  await rm(file, { force: true });
+}
+
+export async function syncGeneratedArtifactToOpenStory(input: {
+  root: string;
+  sessionId: string;
+  exec: GeneratedToolExecution;
+  endpoint?: string;
+  secret?: string;
+  generatedBy?: string;
+}): Promise<boolean> {
+  const details = generatedDetails(input.exec);
+  const binding = await getOpenStorySessionBinding(input.root, input.sessionId);
+  if (!details || !binding || !input.endpoint || !input.secret) return false;
+
+  const scriptPath = safeChildPath(input.root, details.scriptPath);
+  const markdown = await readFile(scriptPath, "utf-8");
+  const artifactKind =
+    details.kind === "script_created" ? "script" : "interactive-film";
+  const revision = Date.now();
+  const eventId = randomUUID();
+  const chapters = normalizeScriptChapters(
+    markdown,
+    artifactKind,
+    details.projectId,
+    new Date(revision).toISOString(),
+  );
+  const unsigned = {
+    schemaVersion: 1 as const,
+    eventId,
+    binding,
+    artifactKind,
+    revision,
+    generatedBy: input.generatedBy,
+    chapters,
+  };
+  const payloadHash = sha256(JSON.stringify(unsigned));
+  const body = JSON.stringify({ ...unsigned, payloadHash });
+  await enqueueAndDeliver(
+    input.root,
+    input.endpoint,
+    input.secret,
+    eventId,
+    body,
+  );
+  return true;
+}
+
+export async function flushOpenStoryOutbox(input: {
+  root: string;
+  endpoint?: string;
+  secret?: string;
+}): Promise<number> {
+  if (!input.endpoint || !input.secret) return 0;
+  const existing = outboxFlushes.get(input.root);
+  if (existing) return existing;
+  const current = (async () => {
+    const directory = inkosMetaPath(input.root, OUTBOX_DIR);
+    let files: string[];
+    try {
+      files = (await readdir(directory)).filter((file) =>
+        file.endsWith(".json"),
+      );
+    } catch {
+      return 0;
+    }
+
+    let delivered = 0;
+    for (const file of files) {
+      const path = join(directory, file);
+      try {
+        const body = await readFile(path, "utf-8");
+        await deliver(input.endpoint!, input.secret!, body);
+        await rm(path, { force: true });
+        delivered++;
+      } catch {
+        // Keep the outbox file for the next retry.
+      }
+    }
+    return delivered;
+  })();
+  outboxFlushes.set(input.root, current);
+  try {
+    return await current;
+  } finally {
+    if (outboxFlushes.get(input.root) === current) {
+      outboxFlushes.delete(input.root);
+    }
+  }
+}
