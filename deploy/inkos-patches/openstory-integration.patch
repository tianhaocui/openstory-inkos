+import { afterEach, describe, expect, it, vi } from "vitest";
+import { heartbeatJsonResponse } from "./heartbeat-json";
+
+describe("heartbeatJsonResponse", () => {
+  afterEach(() => vi.useRealTimers());
+
+  it("sends a JSON-safe keepalive before the inner request completes", async () => {
+    vi.useFakeTimers();
+    let complete!: (response: Response) => void;
+    const inner = new Promise<Response>((resolve) => {
+      complete = resolve;
+    });
+    const response = heartbeatJsonResponse(() => inner);
+    const reader = response.body!.getReader();
+
+    const first = await reader.read();
+    expect(new TextDecoder().decode(first.value)).toBe(" \n");
+    expect(response.headers.get("x-accel-buffering")).toBe("no");
+
+    const heartbeat = reader.read();
+    await vi.advanceTimersByTimeAsync(15_000);
+    const second = await heartbeat;
+    expect(new TextDecoder().decode(second.value)).toBe(" \n");
+
+    complete(Response.json({ ok: true }));
+    let remainder = "";
+    for (;;) {
+      const chunk = await reader.read();
+      if (chunk.done) break;
+      remainder += new TextDecoder().decode(chunk.value);
+    }
+    expect(JSON.parse(remainder)).toEqual({ ok: true });
+  });
+});
diff --git a/packages/studio/src/api/heartbeat-json.ts b/packages/studio/src/api/heartbeat-json.ts
new file mode 100644
index 0000000..2d00f83
--- /dev/null
+++ b/packages/studio/src/api/heartbeat-json.ts
@@ -0,0 +1,57 @@
+export interface HeartbeatJsonOptions {
+  readonly intervalMs?: number;
+}
+
+/**
+ * Sends JSON-safe whitespace immediately and periodically while a long request
+ * runs. The final body remains valid JSON because leading whitespace is legal.
+ */
+export function heartbeatJsonResponse(
+  run: () => Response | Promise<Response>,
+  options: HeartbeatJsonOptions = {},
+): Response {
+  const encoder = new TextEncoder();
+  const intervalMs = options.intervalMs ?? 15_000;
+  let closed = false;
+  let heartbeat: ReturnType<typeof setInterval> | undefined;
+
+  const stream = new ReadableStream<Uint8Array>({
+    start(controller) {
+      const enqueue = (value: string) => {
+        if (!closed) controller.enqueue(encoder.encode(value));
+      };
+      const finish = (value: string) => {
+        if (closed) return;
+        if (heartbeat) clearInterval(heartbeat);
+        enqueue(value);
+        closed = true;
+        controller.close();
+      };
+
+      enqueue(" \n");
+      heartbeat = setInterval(() => enqueue(" \n"), intervalMs);
+
+      void Promise.resolve(run()).then(async (response) => {
+        const responseBody = await response.text();
+        finish(
+          responseBody ||
+            JSON.stringify({ error: `Agent request failed with HTTP ${response.status}` }),
+        );
+      }).catch((error: unknown) => {
+        finish(JSON.stringify({ error: error instanceof Error ? error.message : String(error) }));
+      });
+    },
+    cancel() {
+      closed = true;
+      if (heartbeat) clearInterval(heartbeat);
+    },
+  });
+
+  return new Response(stream, {
+    headers: {
+      "content-type": "application/json; charset=UTF-8",
+      "cache-control": "no-cache, no-transform",
+      "x-accel-buffering": "no",
+    },
+  });
+}
